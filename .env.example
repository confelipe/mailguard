# ==============================================================================
# MailGuard - Template de Configuração de Ambiente (.env.example)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para .env:
#    cp .env.example .env
# 2. Preencha os valores de acordo com a infraestrutura do seu cluster.
# 3. O arquivo .env está no .gitignore e NUNCA será commitado.
# ==============================================================================

# Kubernetes
NAMESPACE=infraestrutura
CLUSTER_ISSUER=cluster-ca-issuer

# Postfix MTA & Office 365 Relay
MYHOSTNAME=mailguard.local
SMTP_RELAY_HOST=[smtp.office365.com]:25
TZ=America/Sao_Paulo

# SIEM & Logs (Syslog UDP)
GRAYLOG_HOST=graylog.local
GRAYLOG_PORT=514
WAZUH_HOST=wazuh.local
WAZUH_PORT=1514

# Web Dashboard (HTTPS :443)
DASHBOARD_PORT=443
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=Admin@2026
SESSION_SECRET=mailguard-secret-key-2026

# Docker Registry
IMAGE_TAG=seu-registry/mailguard:3.4
